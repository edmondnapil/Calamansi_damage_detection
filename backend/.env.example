# Copy to backend/.env and fill in. NEVER commit backend/.env.

# --- Supabase (Project Settings -> API) --------------------------------------
# Leave both empty to use the local SQLite fallback (backend/data/).
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The service_role / secret key. Server-side only - never put it in the frontend.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
SUPABASE_BUCKET=leaf-images

# auto = Supabase when the two values above are set, otherwise local
# supabase = require Supabase, local = always use the local SQLite fallback
DB_BACKEND=auto

# --- Application ---------------------------------------------------------------
# Keep a copy of each uploaded image for the detection history (true/false)
KEEP_UPLOADED_IMAGES=true
MAX_UPLOAD_MB=5
# Predictions below this confidence are flagged "low confidence" in the UI
LOW_CONFIDENCE_THRESHOLD=0.70
# Used to group detections by calendar day in charts and reports
APP_TIMEZONE=Asia/Manila
# Frontend origins allowed to call the API (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Dataset -------------------------------------------------------------------
# Folder containing train/ valid/ test/ (or healthy/ damaged/). Default: project root.
# DATASET_DIR=C:\path\to\dataset

# --- Accounts & security (Supabase Auth is used; it needs the two SUPABASE_ values above) ---
# Set to true when the app is served over HTTPS (production) so cookies are HTTPS-only.
AUTH_COOKIE_SECURE=false
# How long "stay signed in" lasts (refresh token cookie), in days
AUTH_SESSION_DAYS=7
# Seconds a user must wait before another verification / reset code can be sent
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_HOUR=5
# Wrong codes allowed per sent code before a new code must be requested
OTP_MAX_ATTEMPTS=5
# Failed sign-ins allowed per email before a temporary lockout
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
# Optional: secret for hashing emails/IPs in the audit log (defaults to a value derived from the service key)
# AUTH_HASH_SECRET=
